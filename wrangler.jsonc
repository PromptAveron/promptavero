{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "promptavero",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "promptavero"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "eae30d29280f41cbb683b2824f043e92"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "promptavero-site-tags",
      "database_id": "d4ef29a7-3df5-4c92-8dec-660487461d84"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://promptavero.imgprompts.workers.dev",
    "NEXT_PUBLIC_SUPABASE_URL": "https://njxptjvesqdngotwqnwd.supabase.co",
    "IMAGEKIT_URL_ENDPOINT": "https://ik.imagekit.io/promptavero"
  },
  "observability": {
    "enabled": true
  }
}
